# 至少启用一端；关闭某端时，将该端全部配置留空。
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_GUILD_ID=

POLL_INTERVAL_SECONDS=10
TZ=Asia/Shanghai
DATABASE_PATH=/data/bili.db
HEALTH_PORT=8080

# 可选 HTTP CONNECT 代理。同时覆盖 Bot HTTP 请求和 Discord Gateway。
# 容器内的 127.0.0.1 指向容器自身，请填写容器可访问的代理地址。
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,.bilibili.com,.hdslb.com
