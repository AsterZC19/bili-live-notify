  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/proxy-from-env": "^1.0.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
