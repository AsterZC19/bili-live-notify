  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/proxy-from-env": "^1.0.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
